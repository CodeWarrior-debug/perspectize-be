# Database connection (sevalla - use external endpoint url from "Networking", ?sslmode=disable at end, may work second time)
DATABASE_URL=

# YouTube API (optional)
YOUTUBE_API_KEY=

# JWT Authentication (required in production)
JWT_SECRET=your-secret-key-here-minimum-32-bytes-for-security
ACCESS_TOKEN_MINUTES=15

# Rate Limiting
RATE_LIMIT_PER_MIN=100

# CORS (comma-separated origins)
# Development: CORS_ORIGINS=http://localhost:5173
# Production: CORS_ORIGINS=https://app.perspectize.com
CORS_ORIGINS=*

# Sevalla deployment URLs
SEVALLA_BACKEND_URL=
