{
	"name": "fe",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --project unit",
		"test:run": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test:browser:watch": "vitest --project browser",
		"test:all": "vitest run",
		"test:coverage": "vitest run --project unit --coverage",
		"test:duplication": "jscpd src/ tests/ --min-lines 3 --min-tokens 25 --reporters html --output coverage/duplication",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"cap:sync": "cap sync",
		"cap:open:ios": "cap open ios",
		"cap:open:android": "cap open android",
		"mobile:build": "vite build && cap sync"
	},
	"devDependencies": {
		"@capacitor/android": "^8.5.0",
		"@capacitor/cli": "^7.5.0",
		"@capacitor/ios": "^8.5.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^0.577.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "~2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser": "^4.1.8",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"bits-ui": "^2.18.1",
		"jscpd": "^4.0.8",
		"jsdom": "^28.1.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.7.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.5",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@ag-grid-community/client-side-row-model": "32.3.9",
		"@ag-grid-community/core": "32.3.9",
		"@ag-grid-community/theming": "32.3.9",
		"@capacitor/core": "^8.5.0",
		"@capacitor/haptics": "^8.0.1",
		"@tanstack/svelte-form": "^1.33.0",
		"@tanstack/svelte-query": "^6.1.8",
		"ag-grid-svelte5": "^1.0.3",
		"clsx": "^2.1.1",
		"graphql": "^16.13.1",
		"graphql-request": "^7.4.0",
		"svelte-clerk": "^1.1.9",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.6.0",
		"web-vitals": "^5.3.0"
	},
	"pnpm": {
		"overrides": {
			"postcss": ">=8.5.18",
			"nanoid": ">=3.3.18 <5 || >=5.1.6 <6",
			"js-cookie": ">=3.0.7"
		}
	}
}
