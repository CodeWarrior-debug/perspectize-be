{
	"name": "fe",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:duplication": "jscpd src/ tests/ --min-lines 3 --min-tokens 25 --reporters html --output coverage/duplication",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"cap:sync": "cap sync",
		"cap:open:ios": "cap open ios",
		"cap:open:android": "cap open android",
		"mobile:build": "vite build && cap sync"
	},
	"devDependencies": {
		"@capacitor/android": "^8.1.0",
		"@capacitor/cli": "^7.5.0",
		"@capacitor/ios": "^8.1.0",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.575.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.0.18",
		"bits-ui": "^2.16.3",
		"jscpd": "^4.0.8",
		"jsdom": "^28.1.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@ag-grid-community/client-side-row-model": "32.3.9",
		"@ag-grid-community/core": "32.3.9",
		"@ag-grid-community/theming": "32.3.9",
		"@capacitor/core": "^8.1.0",
		"@capacitor/haptics": "^7.0.3",
		"@tanstack/svelte-form": "^1.28.4",
		"@tanstack/svelte-query": "^6.0.18",
		"ag-grid-svelte5": "^1.0.3",
		"clsx": "^2.1.1",
		"graphql": "^16.13.1",
		"graphql-request": "^7.4.0",
		"svelte-sonner": "^1.0.8",
		"tailwind-merge": "^3.4.1",
		"web-vitals": "^5.1.0"
	}
}
