/**
 * Renovate Configuration — perspectize (monorepo)
 * =================================================
 *
 * WHY RENOVATE OVER DEPENDABOT?
 * - Grouping: Renovate can batch multiple package updates into a single PR.
 *   Dependabot opens one PR per package — in a monorepo with 50+ deps, that
 *   means 50+ PRs. Renovate can reduce that to 4 grouped PRs.
 * - Monorepo awareness: Renovate understands that go.mod and package.json
 *   in different directories are part of the same repo. It deduplicates
 *   updates and respects workspace structures.
 * - Dependency Dashboard: a GitHub issue that acts as a control panel for
 *   all pending updates — trigger, defer, or ignore from one place.
 * - Flexible scheduling & grouping: cron-based schedules combined with
 *   regex-based package grouping give you fine-grained control.
 *
 * THIS REPO'S STRATEGY:
 * - All updates enabled (major, minor, patch) for both Go and TypeScript.
 * - PRs are GROUPED by ecosystem so you get ~4 PRs instead of dozens:
 *     1. TypeScript — non-major (minor + patch batched together)
 *     2. TypeScript — major (one PR per major bump for careful review)
 *     3. Go — non-major (minor + patch batched together)
 *     4. Go — major (one PR per major bump for careful review)
 * - No auto-merge — a human reviews every PR.
 * - Security alerts bypass the weekly schedule and come through immediately.
 */
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Start from Renovate's recommended defaults
  "extends": ["config:recommended"],

  // ── Dependency Dashboard ──
  "dependencyDashboard": true,

  // ── No auto-merge ──
  "automerge": false,

  // ── Schedule ──
  "schedule": ["before 9am on Monday"],

  // ── PR limits ──
  "prConcurrentLimit": 10,

  // ── Default labels ──
  "labels": ["dependencies", "renovate"],

  "packageRules": [
    {
      "description": "Group all TypeScript/JS non-major updates into one PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "TypeScript Dependencies (non-major)",
      "groupSlug": "ts-non-major",
      "labels": ["dependencies", "typescript", "renovate"]
    },
    {
      "description": "TypeScript/JS major updates — separate PRs for careful review",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "TypeScript Dependencies (major)",
      "groupSlug": "ts-major",
      "labels": ["dependencies", "typescript", "major", "renovate"],
      "commitMessagePrefix": "⚠️ major:"
    },
    {
      "description": "Group all Go non-major updates into one PR",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go Dependencies (non-major)",
      "groupSlug": "go-non-major",
      "labels": ["dependencies", "go", "renovate"]
    },
    {
      "description": "Go major updates — separate PRs for careful review",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go Dependencies (major)",
      "groupSlug": "go-major",
      "labels": ["dependencies", "go", "major", "renovate"],
      "commitMessagePrefix": "⚠️ major:"
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies", "renovate"],
    "prPriority": 10,
    "schedule": ["at any time"],
    "commitMessagePrefix": "🔒 security:"
  }
}
